# Postgres. `docker compose up -d db` from the repo root matches this default.
DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5433/leadgen

# Where contractors come from: "fixture" (synthetic sample data, works offline) or "gaf" (live scraper, see sources/gaf.py)
LEAD_SOURCE=fixture

# Insight generation: "heuristic" (free, deterministic) or "claude" (needs an API key)
INSIGHTS_BACKEND=heuristic
INSIGHTS_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# --- Manufacturer <-> contractor matching ---
# Setting a key turns on evidence collection + LLM matching for every discovered contractor.
# OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4
DEFAULT_MANUFACTURER=gaf
# "fixture" = synthetic reviews/permits/licenses; "live" = NYC Open Data (permits + DCA licenses)
EVIDENCE_SOURCE=fixture
# NYC_OPEN_DATA_APP_TOKEN=
# Google reviews (Places API New, max 5 per contractor). Needs a Google Cloud key with Places API enabled.
# GOOGLE_PLACES_API_KEY=

# --- Live GAF data (see README "Real data") ---
# LEAD_SOURCE=gaf           # real GAF directory + profile pages (opens a visible Chrome window)
# EVIDENCE_SOURCE=live      # real NYC permits + licenses instead of synthetic ones
# DISCOVER_LIMIT=5          # only take the nearest N contractors per run while developing
